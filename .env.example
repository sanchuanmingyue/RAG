LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Ordered Alibaba Cloud model pool. Fill in model IDs from your Model Studio console.
# LLM_MODELS takes precedence over the legacy single-model LLM_MODEL setting.
LLM_MODELS=
LLM_MODEL=
# Explicitly disable Qwen thinking mode for lower-latency RAG answers.
LLM_ENABLE_THINKING=false
# Quota exhaustion skips that model for one day; transient failures use a short cooldown.
LLM_QUOTA_COOLDOWN_SECONDS=86400
LLM_FAILOVER_COOLDOWN_SECONDS=60
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# IEEE Xplore Metadata API, used by the Search page and literature-search requests in Chat.
IEEE_API_KEY=
IEEE_API_BASE_URL=https://ieeexploreapi.ieee.org/api/v1
IEEE_SEARCH_DEFAULT_LIMIT=10
IEEE_SEARCH_TIMEOUT_SECONDS=30

# Optional: use a separate OpenAI-compatible multimodal/VLM endpoint for RAG-Anything.
# If these are omitted, the app falls back to LLM_API_KEY and LLM_BASE_URL.
VISION_API_KEY=
VISION_BASE_URL=
# Use a general instruction-following VLM here. OCR-only models do not return
# the structured JSON required by RAG-Anything's image/table processors.
RAG_ANYTHING_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# auto chooses CUDA when PyTorch can see it; set cpu only for troubleshooting.
RAG_ANYTHING_DEVICE=auto
RAG_ANYTHING_BACKEND=pipeline
# In mainland China, modelscope usually downloads MinerU models more reliably.
RAG_ANYTHING_SOURCE=modelscope

# RAG-Anything/MinerU parsing options.
# pipeline is the stable default for Windows and 4 GB GPUs; hybrid-auto-engine needs more resources.
# Set RAG_ANYTHING_FORMULA=false if MinerU fails during "MFR Predict".
RAG_ANYTHING_IMAGE=true
RAG_ANYTHING_TABLE=true
RAG_ANYTHING_FORMULA=true
MINERU_LOCAL_API_STARTUP_TIMEOUT_SECONDS=600
MINERU_TASK_RESULT_TIMEOUT_SECONDS=7200
MINERU_TASK_RESULT_DOWNLOAD_TIMEOUT_SECONDS=1200

CHROMA_COLLECTION=paper_reader_chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
# Queries scoped to all/multiple papers use more final sections automatically.
MULTI_PAPER_TOP_K=10
RETRIEVAL_MODE=hybrid
HYBRID_CANDIDATE_K=24
ENABLE_TWO_STAGE_RETRIEVAL=true
DOCUMENT_CANDIDATE_K=50
DOCUMENT_TOP_K=5
SECTION_CANDIDATE_K=50
SECTION_SUPPORT_CHUNKS=3
# Up to three relevant 800-character chunks per section; Top-5 stays bounded.
QA_SOURCE_MAX_CHARS=2400
QA_CONTEXT_MAX_CHARS=12000
# Applies to paper QA only; summaries and comparison reports keep their normal limit.
QA_MAX_TOKENS=600
REFERENCE_SECTION_PENALTY=0.35
ENABLE_SECTION_INDEX=true
SECTION_DOCUMENT_MAX_CHARS=12000
KEYWORD_QUERY_CACHE_SIZE=64
ENABLE_SECTION_RERANKER=true
RERANKER_PROVIDER=siliconflow
RERANKER_API_KEY=
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_K=8
RERANKER_WEIGHT=0.65
RERANKER_DOCUMENT_MAX_CHARS=2000
RERANKER_TIMEOUT_SECONDS=45
RERANKER_MAX_CHUNKS_PER_DOC=8
RERANKER_OVERLAP_TOKENS=64
ENABLE_CROSS_ENCODER_RERANKER=true
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_CANDIDATE_K=8
CROSS_ENCODER_WEIGHT=0.65
CROSS_ENCODER_BATCH_SIZE=8
CROSS_ENCODER_LOCAL_FILES_ONLY=true
PRELOAD_CROSS_ENCODER=false
ENABLE_STARTUP_WARMUP=true
RRF_K=60
ENABLE_RERANKER=true
ENABLE_PARENT_CONTEXT=true
EMBEDDING_SECTION_CONTEXT=true
ENABLE_SECTION_DIVERSITY=true
SECTION_HEADING_WEIGHT=0.25
SECTION_MAX_CHUNKS=2
QUERY_EMBEDDING_CACHE_SIZE=256
STRICT_CITATION=true
ANSWER_CORRECTNESS_THRESHOLD=0.70
ANSWER_CORRECTNESS_BORDERLINE_LOW=0.60
ANSWER_CORRECTNESS_BORDERLINE_HIGH=0.75
ANSWER_JUDGE_ENABLED=true
# Embedding-based proxy metrics for claim-level citation support.
CLAIM_CITATION_EVAL_ENABLED=true
CLAIM_CITATION_SIMILARITY_THRESHOLD=0.55
# Retry suspicious binary answers whose stated polarity conflicts with their comparison explanation.
BINARY_CONSISTENCY_RETRY=true
# Optional ordered judge-only Alibaba Cloud models. Empty means reuse LLM_MODELS.
ANSWER_JUDGE_MODELS=
API_MAX_UPLOAD_MB=50
API_BACKGROUND_WORKERS=2
